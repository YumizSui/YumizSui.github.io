          <img src="/profile.png" alt="@YumizSui" class="w-full rounded-lg shadow-lg" />
        </div>
        <div class="md:w-2/3">
          <h1 class="text-4xl font-bold mb-2">
            <a href="https://orcid.org/0000-0003-1097-0003" target="_blank" rel="noopener noreferrer" class="text-inherit hover:text-inherit no-underline">
              Kairi Furui
            </a>
